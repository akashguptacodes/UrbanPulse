# ==============================================================================
# UrbanPulse — Backend Service Environment Variables (Node.js / Express)
# Copy this file to backend/.env for local development. Never commit real credentials.
# ==============================================================================

# Server Runtime & Port
NODE_ENV=development
PORT=4000

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL / Neon)
# Local development default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbanpulse?schema=public
# Cloud Neon example:
# DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/urbanpulse?sslmode=require

# Authentication Secrets
JWT_SECRET=development-jwt-secret-min-32-characters-long-key
JWT_EXPIRES_IN=7d

# Microservices URLs
DUPLICATE_SERVICE_URL=http://localhost:8001
PRIORITY_SERVICE_URL=http://localhost:8002
