NODE_ENV=development
PORT=4000

CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbanpulse?schema=public

JWT_SECRET=development-jwt-secret-min-32-characters-long-key
JWT_EXPIRES_IN=7d

DUPLICATE_SERVICE_URL=http://localhost:8001
PRIORITY_SERVICE_URL=http://localhost:8002
AI_REQUEST_TIMEOUT_MS=3000
AI_INTEGRATION_ENABLED=true

# Storage Provider ('local' or 'cloudinary')
STORAGE_PROVIDER=local
# If using Cloudinary:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
