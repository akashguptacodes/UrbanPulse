# ==============================================================================
# UrbanPulse — Decoupled Multi-Service Environment Overview
# ==============================================================================
# UrbanPulse is structured for independent deployment of its 4 services.
# Each service maintains its own self-contained `.env` file in its own directory:
#
# 1. Frontend:               frontend/.env
#    Template:               frontend/.env.example
#
# 2. Backend:                backend/.env
#    Template:               backend/.env.example
#
# 3. Priority Service:       ai-services/priority_service/.env
#    Template:               ai-services/priority_service/.env.example
#
# 4. Duplicate Service:      ai-services/duplicate_service/.env
#    Template:               ai-services/duplicate_service/.env.example
#
# For quick local setup across all 4 services, copy each template:
#   cp frontend/.env.example frontend/.env
#   cp backend/.env.example backend/.env
#   cp ai-services/priority_service/.env.example ai-services/priority_service/.env
#   cp ai-services/duplicate_service/.env.example ai-services/duplicate_service/.env
# ==============================================================================

# --- Quick Reference by Service ---

# [1] FRONTEND (frontend/.env)
# VITE_API_BASE_URL=http://localhost:4000/api
# PORT=5173

# [2] BACKEND (backend/.env)
# NODE_ENV=development
# PORT=4000
# CORS_ORIGIN=http://localhost:5173
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbanpulse?schema=public
# JWT_SECRET=development-jwt-secret-min-32-characters-long-key
# JWT_EXPIRES_IN=7d
# DUPLICATE_SERVICE_URL=http://localhost:8001
# PRIORITY_SERVICE_URL=http://localhost:8002

# [3] PRIORITY SERVICE (ai-services/priority_service/.env)
# PORT=8002
# HOST=127.0.0.1
# ENVIRONMENT=development
# SERVICE_NAME=priority_service
# VERSION=0.1.0

# [4] DUPLICATE SERVICE (ai-services/duplicate_service/.env)
# PORT=8001
# HOST=127.0.0.1
# ENVIRONMENT=development
# SERVICE_NAME=duplicate_service
# VERSION=0.1.0
