# ==============================================================================
# UrbanPulse — Environment Variables Template
# Copy this file to .env for local development. Never commit real credentials.
# ==============================================================================

# Node / Environment
NODE_ENV=development

# Backend Service (Node.js / Express)
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=development-jwt-secret-min-32-characters-long-key
JWT_EXPIRES_IN=7d

# PostgreSQL / Neon Database Connection
# Local development default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbanpulse?schema=public
# Neon Cloud example:
# DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/urbanpulse?sslmode=require

# Frontend Service (React / Vite)
FRONTEND_PORT=5173
VITE_BACKEND_URL=http://localhost:4000/api

# AI Microservices (FastAPI)
DUPLICATE_SERVICE_PORT=8001
DUPLICATE_SERVICE_HOST=127.0.0.1
DUPLICATE_SERVICE_URL=http://localhost:8001

PRIORITY_SERVICE_PORT=8002
PRIORITY_SERVICE_HOST=127.0.0.1
PRIORITY_SERVICE_URL=http://localhost:8002
